{
    "name": "libjxl",
    "version": "1.0.1",
    "description": "JXL decoder",
    "filters":["jxldec","rfjxl"],
    "help": "This filter decodes JXL images using libjxl.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libjxl.accessor",
    "filter_source":{
        "jxldec" : "dec_jxl.c",
        "rfjxl" : "reframe_jxl.c"
    },
    "extension":{
      "jxl" : "img"
    },
    "using": ["solver_minimal_1"],
    "runtime": {
        "jxldec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_RGB",
                        "GF_PIXEL_RGBA"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "JPEG XL, royalty-free",
        "checked": "2026-10-16"
    }
}
